                            <path d="M 16 200 Q 6 188, -2 184"/>
                            <path d="M 16 200 Q 28 188, 36 182"/>
                            <path d="M 16 196 Q 8 178, 4 168"/>
                            <path d="M 16 196 Q 24 178, 30 170"/>
