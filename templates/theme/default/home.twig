                            <line x1="0" y1="3" x2="36" y2="3" stroke="#A8442B" stroke-width="2"/>
                        </pattern>
                    </defs>
                    {# Mustard sun disc — fingerprint #1 #}
                    <circle cx="148" cy="118" r="62" fill="#D9A036"/>
                    <circle cx="148" cy="118" r="62" fill="none" stroke="#6E6E3C" stroke-width="2"/>
                    {# Sun rays — sparse strokes #}
                    <g stroke="#6E6E3C" stroke-width="2" stroke-linecap="round" fill="none">
                        <line x1="148" y1="32" x2="148" y2="50"/>
                        <line x1="60" y1="118" x2="78" y2="118"/>
                        <line x1="218" y1="118" x2="236" y2="118"/>
                        <line x1="88" y1="58" x2="102" y2="72"/>
                        <line x1="208" y1="58" x2="194" y2="72"/>
                        <line x1="88" y1="178" x2="102" y2="164"/>
                        <line x1="208" y1="178" x2="194" y2="164"/>
                    </g>
                    {# Distant hill — single soft contour #}
                    <path d="M 0 300 Q 180 240, 340 280 T 720 270 L 720 320 L 0 320 Z" fill="#FBF7EC" stroke="#6E6E3C" stroke-width="2"/>
                    {# Banaba tree silhouette (left of house) #}
                    <g stroke="#6E6E3C" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="86" y1="320" x2="86" y2="240"/>
                        <line x1="86" y1="270" x2="64" y2="252"/>
                        <line x1="86" y1="278" x2="106" y2="258"/>
                        <line x1="86" y1="252" x2="72" y2="232"/>
                        <line x1="86" y1="252" x2="100" y2="232"/>
                    </g>
                    <g fill="#6E6E3C">
