                        <path d="M 330 120 L 350 130" stroke="#6E6E3C" stroke-width="2"/>
                        {# Jalousie indication #}
                        <g stroke="#A8442B" stroke-width="1.5">
                            <line x1="130" y1="156" x2="180" y2="156"/>
                            <line x1="130" y1="166" x2="180" y2="166"/>
                            <line x1="130" y1="176" x2="180" y2="176"/>
                            <line x1="130" y1="186" x2="180" y2="186"/>
                            <line x1="220" y1="156" x2="270" y2="156"/>
                            <line x1="220" y1="166" x2="270" y2="166"/>
                            <line x1="220" y1="176" x2="270" y2="176"/>
                            <line x1="220" y1="186" x2="270" y2="186"/>
                        </g>
                        {# Sun + arrow showing rainflow path #}
                        <circle cx="60" cy="60" r="18" fill="#D9A036"/>
                        <path d="M 200 178 L 200 218" stroke="#A8442B" stroke-width="1.5" stroke-dasharray="3 3" fill="none"/>
                        <path d="M 195 213 L 200 220 L 205 213" stroke="#A8442B" stroke-width="1.5" fill="none"/>
                        {# Scale notation #}
