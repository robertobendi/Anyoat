                        <circle cx="78" cy="232" r="9"/>
                        <circle cx="92" cy="225" r="10"/>
                        <circle cx="106" cy="234" r="12"/>
                        <circle cx="106" cy="258" r="9"/>
                        <circle cx="86" cy="244" r="13"/>
