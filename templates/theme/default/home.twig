{% extends '@theme/layout.twig' %}

{% block title %}Anyo at Disenyo — Architectural practice, Batangas{% endblock %}
{% block description %}Anyo at Disenyo is a Batangas architectural practice designing homes and small buildings shaped by Philippine light, climate, and the way a family actually lives in a room.{% endblock %}

{% block vertical_folio %}
<div class="vertical-folio" aria-hidden="true">FOLIO 01 / 2026 · ANYO AT DISENYO · BATANGAS</div>
{% endblock %}

{% block content %}

{# ── HERO — fingerprint #1, #2, #3, #6 ──────────────────────────── #}
