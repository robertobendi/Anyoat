                            <line x1="0" y1="-16" x2="0" y2="16" stroke="#6E6E3C" stroke-width="1.2"/>
                            <line x1="-16" y1="0" x2="16" y2="0" stroke="#6E6E3C" stroke-width="1.2"/>
