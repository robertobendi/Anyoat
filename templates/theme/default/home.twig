                            <path d="M 384 200 Q 394 188, 402 184"/>
                            <path d="M 384 200 Q 372 188, 364 182"/>
                            <path d="M 384 196 Q 392 178, 396 168"/>
                            <path d="M 384 196 Q 376 178, 370 170"/>
