                        </g>
                        {# Furniture cues #}
                        <rect x="48" y="80" width="42" height="14" fill="#D9A036" opacity="0.85"/>
                        <rect x="48" y="110" width="42" height="14" fill="#D9A036" opacity="0.85"/>
                        <circle cx="220" cy="100" r="10" fill="#D9A036" opacity="0.85"/>
                        <rect x="295" y="200" width="55" height="40" fill="none" stroke="#6E6E3C" stroke-width="1.5"/>
