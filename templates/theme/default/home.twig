                    </g>
                    {# Jalousie window cluster — center right #}
                    <g>
                        <rect x="484" y="260" width="118" height="86" fill="url(#jalousie)" stroke="#6E6E3C" stroke-width="2"/>
                        <line x1="543" y1="260" x2="543" y2="346" stroke="#6E6E3C" stroke-width="2"/>
                    </g>
                    {# Stilts — short, suggesting the house is slightly raised #}
                    <g stroke="#6E6E3C" stroke-width="2.5" fill="none">
                        <line x1="262" y1="392" x2="262" y2="424"/>
                        <line x1="298" y1="392" x2="298" y2="424"/>
                        <line x1="582" y1="392" x2="582" y2="424"/>
                        <line x1="618" y1="392" x2="618" y2="424"/>
                    </g>
