{# ── SECTION III — THE ARCHITECT ────────────────────────────────── #}
<section class="section section--lg">
    <div class="container">
        <p class="eyebrow">Section III <span class="square-mark"></span> The architect</p>
        <div class="grid12" style="row-gap: 1.4rem; align-items: start;">
            <div class="span-4" style="grid-column: 1 / span 4; color: var(--olive);">
                {# Compass rose + plan square illustration #}
                <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%; max-width: 280px; display:block;">
                    {# outer ring #}
                    <circle cx="120" cy="120" r="100" fill="none" stroke="#6E6E3C" stroke-width="2"/>
                    {# inner ring #}
                    <circle cx="120" cy="120" r="68" fill="none" stroke="#6E6E3C" stroke-width="1.5"/>
                    {# 4-point compass star (terracotta filled) #}
                    <path d="M 120 20 L 132 110 L 220 120 L 132 132 L 120 220 L 108 132 L 20 120 L 108 108 Z" fill="#A8442B" stroke="#6E6E3C" stroke-width="1.5"/>
                    {# Smaller cross #}
                    <path d="M 120 60 L 124 117 L 180 120 L 124 124 L 120 180 L 116 124 L 60 120 L 116 117 Z" fill="#D9A036" stroke="#6E6E3C" stroke-width="1"/>
                    {# Center disc #}
                    <circle cx="120" cy="120" r="6" fill="#6E6E3C"/>
                    {# Cardinal letters #}
                    <text x="120" y="14" text-anchor="middle" font-family="Khand, sans-serif" font-weight="700" font-size="14" fill="#6E6E3C" letter-spacing="2">N</text>
                    <text x="120" y="236" text-anchor="middle" font-family="Khand, sans-serif" font-weight="700" font-size="14" fill="#6E6E3C" letter-spacing="2">S</text>
                    <text x="8" y="125" text-anchor="middle" font-family="Khand, sans-serif" font-weight="700" font-size="14" fill="#6E6E3C" letter-spacing="2">W</text>
                    <text x="232" y="125" text-anchor="middle" font-family="Khand, sans-serif" font-weight="700" font-size="14" fill="#6E6E3C" letter-spacing="2">E</text>
                </svg>
            </div>
            <div style="grid-column: 6 / span 7; min-width: 0;">
                <h2 style="margin-top: 0;">A small office, in person, in Batangas.</h2>
                <p>The practice was founded to do residential and small-commercial work for clients who want to be present in the design of their own building. We meet at the site. We draw by hand first, in a notebook, before any line goes into a computer.</p>
                <p>We work on a small number of projects each year so that nothing is generic and nothing is rushed. We answer the phone. We send Messenger replies in Tagalog or English, whichever you prefer.</p>
                <p style="margin-top: 1.4rem;"><a class="btn--ghost" href="/practice">Read about the practice</a></p>
            </div>
        </div>
    </div>
</section>

{# ── INQUIRY STRIP — fingerprint #2 (terracotta rule) ──────────── #}
<div class="strip">
    <hr class="rule-4" style="position: absolute; top: 0; left: 0; right: 0;">
    <div class="strip__inner">
        <p class="strip__phrase">Bahay, <em>anyo,</em><br>hangin.</p>
        <div class="strip__cta">
            <p class="eyebrow eyebrow--charcoal" style="margin: 0 0 0.4rem;">Section V <span class="square-mark"></span> Inquiry</p>
            <p style="color: var(--ink); max-width: 32ch; margin: 0 0 1rem;">Begin a project. We reply within two working days.</p>
            <p style="margin: 0;">
                <a class="btn" href="/inquiry">Make an inquiry</a>
            </p>
        </div>
    </div>
</div>

{% endblock %}
