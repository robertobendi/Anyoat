{% extends '@theme/layout.twig' %}

{% block title %}Folio — Work · Anyo at Disenyo{% endblock %}
{% block description %}A printed folio of houses, rooms, plans, and the climate that shapes them — recent and forthcoming work from Anyo at Disenyo, Batangas.{% endblock %}

{% block vertical_folio %}
<div class="vertical-folio" aria-hidden="true">FOLIO 02 / 2026 · WORK · ANYO AT DISENYO</div>
{% endblock %}

{% block content %}

{# ── FOLIO COVER — banaba tree illustration + H1 ───────────────── #}
<section class="hero">
    <div class="container">
        <div class="hero__grid">
            <div class="hero__illustration" aria-hidden="true">
                <svg viewBox="0 0 720 540" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Line drawing of a banaba tree">
                    {# Mustard sun disc behind canopy #}
                    <circle cx="540" cy="148" r="58" fill="#D9A036" opacity="0.9"/>
                    {# Distant hills #}
                    <path d="M 0 360 Q 200 300 360 340 T 720 320 L 720 410 L 0 410 Z" fill="#FBF7EC" stroke="#6E6E3C" stroke-width="2"/>
                    {# Trunk #}
                    <g stroke="#6E6E3C" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M 320 480 Q 305 360, 318 250 Q 325 200, 340 168"/>
                        <path d="M 318 250 Q 290 220, 270 200"/>
                        <path d="M 320 320 Q 280 290, 248 270"/>
                        <path d="M 322 220 Q 360 200, 392 188"/>
                        <path d="M 326 180 Q 348 158, 380 142"/>
                    </g>
                    {# Canopy — 2pt olive linework, lobed leaf clusters #}
                    <g stroke="#6E6E3C" stroke-width="2" fill="#F0EBDE">
                        <ellipse cx="240" cy="180" rx="38" ry="28" transform="rotate(-18 240 180)"/>
                        <ellipse cx="290" cy="140" rx="48" ry="32" transform="rotate(-10 290 140)"/>
                        <ellipse cx="360" cy="115" rx="55" ry="36" transform="rotate(-2 360 115)"/>
                        <ellipse cx="430" cy="120" rx="52" ry="36" transform="rotate(8 430 120)"/>
                        <ellipse cx="490" cy="160" rx="48" ry="32" transform="rotate(14 490 160)"/>
                        <ellipse cx="450" cy="200" rx="44" ry="28" transform="rotate(2 450 200)"/>
                        <ellipse cx="380" cy="190" rx="46" ry="28" transform="rotate(-4 380 190)"/>
                        <ellipse cx="300" cy="220" rx="42" ry="24" transform="rotate(-8 300 220)"/>
                    </g>
                    {# Mustard fruit dots within canopy #}
                    <g fill="#D9A036" stroke="#6E6E3C" stroke-width="1">
                        <circle cx="312" cy="138" r="6"/>
                        <circle cx="378" cy="105" r="7"/>
                        <circle cx="432" cy="135" r="6"/>
                        <circle cx="476" cy="178" r="6"/>
                        <circle cx="350" cy="170" r="6"/>
                        <circle cx="408" cy="205" r="7"/>
                        <circle cx="280" cy="200" r="5"/>
                        <circle cx="455" cy="170" r="5"/>
                    </g>
                    {# Terracotta flower clusters #}
                    <g fill="#A8442B" opacity="0.85">
                        <circle cx="270" cy="155" r="4"/>
                        <circle cx="278" cy="152" r="3"/>
                        <circle cx="266" cy="148" r="3"/>
                        <circle cx="395" cy="155" r="4"/>
                        <circle cx="402" cy="160" r="3"/>
                        <circle cx="388" cy="158" r="3"/>
                        <circle cx="500" cy="138" r="4"/>
                        <circle cx="506" cy="143" r="3"/>
                    </g>
                    {# Ground line #}
                    <line x1="0" y1="480" x2="720" y2="480" stroke="#6E6E3C" stroke-width="2"/>
                    {# Plate label #}
                    <g fill="#6E6E3C" font-family="Khand, sans-serif" font-size="13" font-weight="600" letter-spacing="2">
                        <text x="20" y="510">FIG. 02 — BANABA · LAGERSTROEMIA SPECIOSA · DRAWN IN OLIVE</text>
                    </g>
                </svg>
            </div>

            <div class="hero__text">
                <p class="folio">Folio 02 / 2026 <span class="square-mark"></span> Work</p>
                <h1 class="hero__h1">Houses,<br>rooms,<br>plans,<br><em>and the climate</em></h1>
                <p class="hero__deck hero__deck--ink" style="margin-top: 1rem;">A folio of recent and forthcoming projects — residential and small-commercial work for clients in Batangas, Calabarzon, and abroad.</p>
            </div>
        </div>
        <hr class="rule-4">
    </div>
</section>

{# ── PLATE SEQUENCE — from DB if present, otherwise hardcoded ──── #}
<section class="section">
    <div class="container">
        <p class="eyebrow">Section II <span class="square-mark"></span> The folio</p>
        <h2>Recent work.</h2>

        <div class="plate-folio">

            {% if entries|default([])|length > 0 %}
                {% for entry in entries %}
                    {% set num = entry.field('plate_number') ?? loop.index %}
                    <article class="plate-folio__item">
                        <div class="plate-folio__figure">
                            <div class="plate-folio__figure-inner">
                                <span class="plate-folio__badge">Plate {{ "%02d"|format(num) }}</span>
                                {% if entry.field('hero_image') %}
                                    <img src="{{ entry.field('hero_image') }}" alt="{{ entry.field('title') }}">
                                {% else %}
                                    <svg viewBox="0 0 400 250" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <rect x="40" y="50" width="320" height="160" fill="none" stroke="#6E6E3C" stroke-width="2"/>
                                        <path d="M 30 50 L 200 14 L 370 50" stroke="#A8442B" stroke-width="2" fill="none"/>
                                        <line x1="170" y1="50" x2="170" y2="210" stroke="#6E6E3C" stroke-width="2"/>
                                    </svg>
                                {% endif %}
                            </div>
                        </div>
                        <div class="plate-folio__body">
                            <p class="eyebrow eyebrow--charcoal" style="margin: 0;">Plate {{ "%02d"|format(num) }}</p>
                            <h3><a href="/work/{{ entry.slug }}" style="text-decoration:none; color: var(--ink);">{{ entry.field('title') }}</a></h3>
                            {% if entry.field('excerpt') %}<p class="plate-folio__copy">{{ entry.field('excerpt') }}</p>{% endif %}
                            <p class="plate-folio__credit">
                                {% if entry.field('location') %}{{ entry.field('location') }}{% endif %}
                                {% if entry.field('project_type') %} · {{ entry.field('project_type') }}{% endif %}
                                {% if entry.field('year') %} · {{ entry.field('year') }}{% endif %}
                            </p>
                        </div>
                    </article>
                {% endfor %}
            {% else %}
                {# Hardcoded plate sequence — graceful default before the editor adds work #}

                <article class="plate-folio__item">
                    <div class="plate-folio__figure">
                        <div class="plate-folio__figure-inner">
                            <span class="plate-folio__badge">Plate 01</span>
                            <svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <defs>
                                    <pattern id="wf1" x="0" y="0" width="32" height="6" patternUnits="userSpaceOnUse">
                                        <line x1="0" y1="3" x2="32" y2="3" stroke="#A8442B" stroke-width="1.6"/>
                                    </pattern>
                                </defs>
                                {# Ground + horizon hills #}
                                <line x1="0" y1="320" x2="640" y2="320" stroke="#6E6E3C" stroke-width="2"/>
                                <path d="M 0 320 Q 180 260 360 290 T 640 280 L 640 320 Z" fill="#FBF7EC" stroke="#6E6E3C" stroke-width="1.5"/>
                                {# Stilts #}
                                <line x1="120" y1="320" x2="120" y2="280" stroke="#6E6E3C" stroke-width="2"/>
                                <line x1="520" y1="320" x2="520" y2="280" stroke="#6E6E3C" stroke-width="2"/>
                                {# Floor slab #}
                                <rect x="110" y="275" width="420" height="8" fill="#A8442B"/>
                                {# Walls #}
                                <line x1="140" y1="275" x2="140" y2="155" stroke="#6E6E3C" stroke-width="2.5"/>
                                <line x1="500" y1="275" x2="500" y2="155" stroke="#6E6E3C" stroke-width="2.5"/>
                                {# Butterfly roof — two slopes, valley center #}
                                <path d="M 110 155 L 320 220 L 530 155" stroke="#6E6E3C" stroke-width="2.5" fill="none"/>
                                <path d="M 110 165 L 320 230 L 530 165" stroke="#6E6E3C" stroke-width="2" fill="none"/>
                                {# Veranda overhangs #}
                                <path d="M 110 155 L 80 168" stroke="#6E6E3C" stroke-width="2.5"/>
                                <path d="M 530 155 L 560 168" stroke="#6E6E3C" stroke-width="2.5"/>
                                {# Jalousies left + right #}
                                <rect x="170" y="190" width="100" height="78" fill="url(#wf1)" stroke="#6E6E3C" stroke-width="1.5"/>
                                <rect x="370" y="190" width="100" height="78" fill="url(#wf1)" stroke="#6E6E3C" stroke-width="1.5"/>
                                {# Door #}
                                <rect x="295" y="210" width="50" height="58" fill="#FBF7EC" stroke="#6E6E3C" stroke-width="1.5"/>
                                {# Rain-flow arrows #}
                                <path d="M 320 230 L 320 285" stroke="#A8442B" stroke-width="1.5" stroke-dasharray="4 4" fill="none"/>
                                <path d="M 315 280 L 320 290 L 325 280" stroke="#A8442B" stroke-width="1.5" fill="none"/>
                                {# Sun #}
                                <circle cx="70" cy="80" r="22" fill="#D9A036"/>
                                <g stroke="#6E6E3C" stroke-width="1.5" fill="none" stroke-linecap="round">
                                    <line x1="70" y1="44" x2="70" y2="54"/>
                                    <line x1="70" y1="106" x2="70" y2="116"/>
                                    <line x1="34" y1="80" x2="44" y2="80"/>
                                    <line x1="96" y1="80" x2="106" y2="80"/>
                                </g>
                                {# Banaba on right edge #}
                                <g stroke="#6E6E3C" stroke-width="1.5" fill="none">
                                    <line x1="600" y1="320" x2="600" y2="250"/>
                                </g>
                                <g fill="#6E6E3C">
                                    <circle cx="592" cy="252" r="8"/>
                                    <circle cx="608" cy="248" r="9"/>
                                    <circle cx="600" cy="236" r="10"/>
                                </g>
                                <text x="20" y="370" font-family="Khand, sans-serif" font-size="13" font-weight="600" fill="#6E6E3C" letter-spacing="2">SECTION A–A · CASA M. · LIPA, BATANGAS · 2024</text>
                            </svg>
                        </div>
                    </div>
                    <div class="plate-folio__body">
                        <p class="eyebrow eyebrow--charcoal" style="margin: 0;">Plate 01</p>
                        <h3>Casa M. — a butterfly-roofed house on a long lot.</h3>
                        <p class="plate-folio__copy">A young family asked for a two-bedroom house on a narrow inland lot. The roof folds inward to catch the rain into a single channel; jalousies on both long elevations carry the breeze through.</p>
                        <p class="plate-folio__credit">Lipa, Batangas · Residential · 2024</p>
                    </div>
                </article>

                <article class="plate-folio__item">
                    <div class="plate-folio__figure">
                        <div class="plate-folio__figure-inner">
                            <span class="plate-folio__badge">Plate 02</span>
                            <svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                {# Floor-plan style — wide bungalow with breezeway #}
                                <g stroke="#6E6E3C" stroke-width="2" fill="none">
                                    <rect x="50" y="80" width="540" height="240"/>
                                    <line x1="220" y1="80" x2="220" y2="320"/>
                                    <line x1="220" y1="200" x2="420" y2="200"/>
                                    <line x1="420" y1="80" x2="420" y2="320"/>
                                    {# breezeway through center #}
                                    <line x1="50" y1="180" x2="50" y2="220" stroke="#A8442B" stroke-width="0"/>
                                    <line x1="50" y1="180" x2="220" y2="180"/>
                                    <line x1="50" y1="220" x2="220" y2="220"/>
                                </g>
                                {# Veranda strip — terracotta #}
                                <rect x="50" y="60" width="540" height="14" fill="#A8442B"/>
                                <rect x="50" y="328" width="540" height="14" fill="#A8442B"/>
                                {# Door swings #}
                                <path d="M 220 90 a 28 28 0 0 1 28 28" stroke="#6E6E3C" stroke-width="1.4" fill="none"/>
                                <path d="M 420 200 a 28 28 0 0 0 -28 28" stroke="#6E6E3C" stroke-width="1.4" fill="none"/>
                                {# Furniture — beds, dining table, sala #}
                                <rect x="80" y="100" width="50" height="70" fill="#D9A036" opacity="0.85"/>
                                <rect x="140" y="100" width="50" height="70" fill="#D9A036" opacity="0.85"/>
                                <circle cx="320" cy="140" r="22" fill="#D9A036" opacity="0.85"/>
                                <circle cx="320" cy="260" r="22" fill="#D9A036" opacity="0.85"/>
                                <rect x="480" y="120" width="80" height="50" fill="none" stroke="#6E6E3C" stroke-width="1.5"/>
                                <rect x="480" y="220" width="80" height="80" fill="none" stroke="#6E6E3C" stroke-width="1.5"/>
                                {# Compass rose #}
                                <g transform="translate(560,360)">
                                    <circle cx="0" cy="0" r="16" fill="none" stroke="#6E6E3C" stroke-width="1.2"/>
                                    <path d="M 0 -18 L 4 0 L 0 18 L -4 0 Z" fill="#6E6E3C"/>
                                    <text x="0" y="-22" text-anchor="middle" font-family="Khand, sans-serif" font-size="10" font-weight="700" fill="#A8442B">N</text>
                                </g>
                                <text x="20" y="370" font-family="Khand, sans-serif" font-size="13" font-weight="600" fill="#6E6E3C" letter-spacing="2">GROUND-FLOOR PLAN · BAHAY SA TABI · CALATAGAN · 2025</text>
                            </svg>
                        </div>
                    </div>
                    <div class="plate-folio__body">
                        <p class="eyebrow eyebrow--charcoal" style="margin: 0;">Plate 02</p>
                        <h3>Bahay sa Tabi — a coastal house, opening on both sides.</h3>
                        <p class="plate-folio__copy">A retirement house for a couple returning from abroad. Two long living wings flank a breezeway open to the sea; verandas on both elevations carry shade across the day.</p>
                        <p class="plate-folio__credit">Calatagan, Batangas · Residential · 2025</p>
                    </div>
                </article>

                <article class="plate-folio__item">
                    <div class="plate-folio__figure">
                        <div class="plate-folio__figure-inner">
                            <span class="plate-folio__badge">Plate 03</span>
                            <svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <defs>
                                    <pattern id="wf3" x="0" y="0" width="28" height="5" patternUnits="userSpaceOnUse">
                                        <line x1="0" y1="2.5" x2="28" y2="2.5" stroke="#A8442B" stroke-width="1.4"/>
                                    </pattern>
                                </defs>
                                {# Long-shop elevation — sari-sari #}
                                <line x1="0" y1="330" x2="640" y2="330" stroke="#6E6E3C" stroke-width="2"/>
                                <path d="M 60 330 L 60 180 L 320 130 L 580 180 L 580 330 Z" fill="none" stroke="#6E6E3C" stroke-width="2.5"/>
                                {# Roof valley accent (butterfly) #}
                                <path d="M 60 180 L 320 220 L 580 180" stroke="#6E6E3C" stroke-width="2" fill="none"/>
                                {# Storefront opening — terracotta lintel #}
                                <rect x="200" y="220" width="240" height="110" fill="#FBF7EC" stroke="#6E6E3C" stroke-width="2"/>
                                <line x1="200" y1="220" x2="440" y2="220" stroke="#A8442B" stroke-width="3"/>
                                {# Counter inside #}
                                <line x1="200" y1="285" x2="440" y2="285" stroke="#6E6E3C" stroke-width="1.5"/>
                                {# Two flanking jalousies #}
                                <rect x="90" y="220" width="90" height="100" fill="url(#wf3)" stroke="#6E6E3C" stroke-width="1.5"/>
                                <rect x="460" y="220" width="90" height="100" fill="url(#wf3)" stroke="#6E6E3C" stroke-width="1.5"/>
                                {# Signage strip on roof front #}
                                <rect x="220" y="158" width="200" height="22" fill="#D9A036" stroke="#6E6E3C" stroke-width="1"/>
                                <text x="320" y="174" text-anchor="middle" font-family="Khand, sans-serif" font-size="13" font-weight="700" fill="#6E6E3C" letter-spacing="2">TINDAHAN NI MANONG</text>
                                {# Small palms #}
                                <g stroke="#6E6E3C" stroke-width="1.5" fill="none">
                                    <line x1="36" y1="330" x2="36" y2="300"/>
                                    <line x1="600" y1="330" x2="600" y2="300"/>
                                </g>
                                <g fill="#6E6E3C">
                                    <circle cx="28" cy="298" r="6"/>
                                    <circle cx="44" cy="296" r="7"/>
                                    <circle cx="36" cy="288" r="6"/>
                                    <circle cx="592" cy="298" r="6"/>
                                    <circle cx="608" cy="296" r="7"/>
                                    <circle cx="600" cy="288" r="6"/>
                                </g>
                                <text x="20" y="370" font-family="Khand, sans-serif" font-size="13" font-weight="600" fill="#6E6E3C" letter-spacing="2">FRONT ELEVATION · SARI-SARI · BATANGAS CITY · 2024</text>
                            </svg>
                        </div>
                    </div>
                    <div class="plate-folio__body">
                        <p class="eyebrow eyebrow--charcoal" style="margin: 0;">Plate 03</p>
                        <h3>Tindahan ni Manong — a sari-sari shop, rebuilt.</h3>
                        <p class="plate-folio__copy">A neighborhood store on a corner lot, rebuilt after typhoon damage. A folded roof catches the rain; a single counter opens to the sidewalk; jalousies on both sides ventilate the back stockroom.</p>
                        <p class="plate-folio__credit">Batangas City · Small commercial · 2024</p>
                    </div>
                </article>

                <article class="plate-folio__item">
                    <div class="plate-folio__figure">
                        <div class="plate-folio__figure-inner">
                            <span class="plate-folio__badge">Plate 04</span>
                            <svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                {# Site plan — house in landscape with banaba tree, paths, garden walls #}
                                {# Site boundary #}
                                <rect x="40" y="40" width="560" height="320" fill="none" stroke="#6E6E3C" stroke-width="2" stroke-dasharray="6 4"/>
                                {# House footprint #}
                                <rect x="200" y="140" width="240" height="160" fill="#FBF7EC" stroke="#6E6E3C" stroke-width="2.5"/>
                                {# Veranda strip — terracotta #}
                                <rect x="184" y="290" width="272" height="14" fill="#A8442B"/>
                                {# Garden path #}
                                <path d="M 100 360 Q 200 320, 320 304" stroke="#6E6E3C" stroke-width="1.5" stroke-dasharray="2 4" fill="none"/>
                                {# Banaba tree — left side #}
                                <g fill="#6E6E3C">
                                    <circle cx="120" cy="160" r="18"/>
                                    <circle cx="140" cy="148" r="20"/>
                                    <circle cx="158" cy="166" r="18"/>
                                    <circle cx="138" cy="178" r="16"/>
                                </g>
                                <g fill="#D9A036">
                                    <circle cx="130" cy="158" r="3"/>
                                    <circle cx="148" cy="155" r="3"/>
                                    <circle cx="142" cy="170" r="3"/>
                                </g>
                                {# Garden — bushes #}
                                <g stroke="#6E6E3C" stroke-width="1.5" fill="none">
                                    <circle cx="500" cy="120" r="14"/>
                                    <circle cx="528" cy="140" r="12"/>
                                    <circle cx="498" cy="280" r="14"/>
                                    <circle cx="524" cy="295" r="11"/>
                                </g>
                                {# Pool / pond — small terracotta rectangle #}
                                <rect x="466" y="200" width="100" height="50" fill="#A8442B" opacity="0.45" stroke="#6E6E3C" stroke-width="1.5"/>
                                {# Compass #}
                                <g transform="translate(70,80)">
                                    <circle cx="0" cy="0" r="14" fill="none" stroke="#6E6E3C" stroke-width="1.2"/>
                                    <path d="M 0 -16 L 4 0 L 0 16 L -4 0 Z" fill="#6E6E3C"/>
                                    <text x="0" y="-20" text-anchor="middle" font-family="Khand, sans-serif" font-size="10" font-weight="700" fill="#A8442B">N</text>
                                </g>
                                <text x="20" y="380" font-family="Khand, sans-serif" font-size="13" font-weight="600" fill="#6E6E3C" letter-spacing="2">SITE PLAN · BAHAY NA BATO · TAYSAN · 2026</text>
                            </svg>
                        </div>
                    </div>
                    <div class="plate-folio__body">
                        <p class="eyebrow eyebrow--charcoal" style="margin: 0;">Plate 04</p>
                        <h3>Bahay na Bato — a stone house, with a banaba tree.</h3>
                        <p class="plate-folio__copy">A modest stone-and-narra family house on a hillside lot. The plan sets the house parallel to the existing banaba so the tree shades the morning dining-room window.</p>
                        <p class="plate-folio__credit">Taysan, Batangas · Residential · forthcoming, 2026</p>
                    </div>
                </article>

                <article class="plate-folio__item">
                    <div class="plate-folio__figure">
                        <div class="plate-folio__figure-inner">
                            <span class="plate-folio__badge">Plate 05</span>
                            <svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                {# Clinic plan — two consult rooms, waiting area #}
                                <g stroke="#6E6E3C" stroke-width="2" fill="none">
                                    <rect x="60" y="60" width="520" height="280"/>
                                    {# Reception + waiting #}
                                    <line x1="60" y1="220" x2="280" y2="220"/>
                                    <line x1="280" y1="60" x2="280" y2="340"/>
                                    {# Consult rooms #}
                                    <line x1="280" y1="200" x2="580" y2="200"/>
                                    <line x1="430" y1="60" x2="430" y2="200"/>
                                    <line x1="430" y1="200" x2="430" y2="340"/>
                                </g>
                                {# Reception counter — terracotta accent #}
                                <rect x="60" y="200" width="220" height="20" fill="#A8442B"/>
                                {# Door swings #}
                                <path d="M 280 110 a 32 32 0 0 1 32 32" stroke="#6E6E3C" stroke-width="1.4" fill="none"/>
                                <path d="M 430 110 a 32 32 0 0 1 32 32" stroke="#6E6E3C" stroke-width="1.4" fill="none"/>
                                <path d="M 430 240 a 32 32 0 0 1 32 32" stroke="#6E6E3C" stroke-width="1.4" fill="none"/>
                                {# Seating — mustard squares for waiting #}
                                <g fill="#D9A036">
                                    <rect x="80" y="100" width="30" height="30"/>
                                    <rect x="120" y="100" width="30" height="30"/>
                                    <rect x="160" y="100" width="30" height="30"/>
                                    <rect x="200" y="100" width="30" height="30"/>
                                    <rect x="80" y="150" width="30" height="30"/>
                                    <rect x="120" y="150" width="30" height="30"/>
                                </g>
                                {# Consult room beds #}
                                <rect x="300" y="100" width="100" height="40" fill="none" stroke="#6E6E3C" stroke-width="1.5"/>
                                <rect x="450" y="100" width="100" height="40" fill="none" stroke="#6E6E3C" stroke-width="1.5"/>
                                <rect x="450" y="250" width="100" height="40" fill="none" stroke="#6E6E3C" stroke-width="1.5"/>
                                <text x="20" y="370" font-family="Khand, sans-serif" font-size="13" font-weight="600" fill="#6E6E3C" letter-spacing="2">CLINIC PLAN · DR. R. · BATANGAS CITY · 2023</text>
                            </svg>
                        </div>
                    </div>
