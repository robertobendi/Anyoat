{% extends '@theme/layout.twig' %}

{% block title %}Practice — On the practice · Anyo at Disenyo{% endblock %}
{% block description %}Anyo at Disenyo is a small, owner-led architectural practice in Batangas. We work on a small number of residential and small-commercial projects each year, in person, with the people who will use the building.{% endblock %}

{% block vertical_folio %}
<div class="vertical-folio" aria-hidden="true">SECTION II / 2026 · ON THE PRACTICE · ANYO AT DISENYO</div>
{% endblock %}

{% block content %}

{# ── SECTION HEAD — compass illustration + H1 ──────────────────── #}
<section class="hero">
    <div class="container">
        <div class="hero__grid">
            <div class="hero__illustration" aria-hidden="true">
                {# Compass + plan square stack #}
                <svg viewBox="0 0 720 540" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Olive line drawing of a compass rose laid over a floor plan">
                    {# Plan square underneath — large, faint #}
                    <g stroke="#6E6E3C" stroke-width="2" fill="none">
                        <rect x="80" y="120" width="560" height="320"/>
                        <line x1="320" y1="120" x2="320" y2="440"/>
                        <line x1="320" y1="280" x2="640" y2="280"/>
                        <line x1="500" y1="280" x2="500" y2="440"/>
                    </g>
                    {# Mustard accent furniture #}
                    <g fill="#D9A036" opacity="0.55">
                        <rect x="120" y="160" width="50" height="80"/>
                        <rect x="180" y="160" width="50" height="80"/>
                        <rect x="120" y="320" width="60" height="60"/>
                        <circle cx="400" cy="200" r="22"/>
                        <rect x="540" y="320" width="80" height="50"/>
                    </g>
                    {# Terracotta veranda strip on plan #}
                    <rect x="80" y="105" width="560" height="14" fill="#A8442B"/>
                    <rect x="80" y="442" width="560" height="14" fill="#A8442B"/>

                    {# Compass overlay — centered #}
                    <g transform="translate(360,280)">
                        <circle cx="0" cy="0" r="110" fill="#F0EBDE" stroke="#6E6E3C" stroke-width="2.5"/>
                        <circle cx="0" cy="0" r="74" fill="none" stroke="#6E6E3C" stroke-width="1.5"/>
                        {# 4-pt star #}
                        <path d="M 0 -100 L 14 -14 L 100 0 L 14 14 L 0 100 L -14 14 L -100 0 L -14 -14 Z"
                              fill="#A8442B" stroke="#6E6E3C" stroke-width="2"/>
                        {# inner 4-pt #}
                        <path d="M 0 -60 L 6 -6 L 60 0 L 6 6 L 0 60 L -6 6 L -60 0 L -6 -6 Z"
                              fill="#D9A036" stroke="#6E6E3C" stroke-width="1"/>
                        <circle cx="0" cy="0" r="5" fill="#6E6E3C"/>
                        <text x="0" y="-118" text-anchor="middle" font-family="Khand, sans-serif" font-weight="700" font-size="18" fill="#6E6E3C" letter-spacing="3">N</text>
                        <text x="0" y="132" text-anchor="middle" font-family="Khand, sans-serif" font-weight="700" font-size="18" fill="#6E6E3C" letter-spacing="3">S</text>
                        <text x="-125" y="5" text-anchor="middle" font-family="Khand, sans-serif" font-weight="700" font-size="18" fill="#6E6E3C" letter-spacing="3">W</text>
                        <text x="125" y="5" text-anchor="middle" font-family="Khand, sans-serif" font-weight="700" font-size="18" fill="#6E6E3C" letter-spacing="3">E</text>
                    </g>
                    <text x="20" y="510" font-family="Khand, sans-serif" font-size="13" font-weight="600" fill="#6E6E3C" letter-spacing="2">FIG. 03 — COMPASS ON PLAN · THE PRACTICE</text>
                </svg>
            </div>
            <div class="hero__text">
                <p class="folio">Section II / 2026 <span class="square-mark"></span> On the practice</p>
                <h1 class="hero__h1">On the<br>practice.</h1>
                <p class="hero__deck hero__deck--ink">A small, owner-led architectural office in Batangas City. Residential and small-commercial work, designed in person with the people who will use the building.</p>
            </div>
        </div>
        <hr class="rule-4">
    </div>
</section>

{# ── PRINCIPAL BLOCK ────────────────────────────────────────────── #}
<section class="section section--lg">
    <div class="container">
        <p class="eyebrow">Section II.A <span class="square-mark"></span> The architect</p>
        <h2>The principal.</h2>

        <div class="principal">
            <div class="principal__portrait" aria-hidden="true">
                {# Olive line-portrait — abstract silhouette #}
                <svg viewBox="0 0 280 360" xmlns="http://www.w3.org/2000/svg">
                    {# Head outline #}
                    <ellipse cx="140" cy="120" rx="62" ry="78" fill="none" stroke="#6E6E3C" stroke-width="2.5"/>
                    {# Hair — flat olive cap #}
                    <path d="M 84 80 Q 95 50, 140 50 Q 192 50, 200 90 L 200 110 L 84 110 Z" fill="#6E6E3C"/>
                    {# Shoulders #}
                    <path d="M 50 320 Q 60 240, 140 220 Q 220 240, 230 320 L 230 360 L 50 360 Z" fill="none" stroke="#6E6E3C" stroke-width="2.5"/>
                    {# Collar — terracotta hint #}
                    <path d="M 110 240 L 140 270 L 170 240" fill="none" stroke="#A8442B" stroke-width="2.5"/>
                    {# Eyes — minimal #}
                    <line x1="115" y1="125" x2="125" y2="125" stroke="#6E6E3C" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="155" y1="125" x2="165" y2="125" stroke="#6E6E3C" stroke-width="2.5" stroke-linecap="round"/>
                    {# Nose hint #}
                    <path d="M 140 135 L 140 152 L 134 158" fill="none" stroke="#6E6E3C" stroke-width="1.5"/>
                    {# Mouth #}
                    <line x1="125" y1="168" x2="155" y2="168" stroke="#6E6E3C" stroke-width="2"/>
                    {# Mustard square stamp #}
                    <rect x="226" y="36" width="14" height="14" fill="#D9A036"/>
                    <text x="22" y="350" font-family="Khand, sans-serif" font-size="11" font-weight="600" fill="#6E6E3C" letter-spacing="2">THE PRINCIPAL</text>
                </svg>
            </div>
            <div class="principal__bio">
                <p>The practice is led by an architect who studied and practiced in Manila before returning to Batangas to work close to the projects and the climate the office understands best. The studio is intentionally small: the same person who sits with you on the site draws the plans and signs them.</p>
                <p>Before founding the office, the principal worked on residential and institutional projects across Calabarzon, including school additions, a small chapel, and several family houses for first-time clients. The current studio practice continues that line — homes, small commercial work, and the occasional civic addition.</p>
                <p>The office works in English and Tagalog, in person and over Messenger, and replies to inquiries within two working days. Site visits across Batangas, Lipa, Calatagan, Taysan, and surrounding municipalities are routine; visits further afield can be arranged.</p>
            </div>

            <div class="principal__pull">
                <p style="margin: 0;">"Hangin, liwanag, lilim — bago ang plano."</p>
                <p class="eyebrow eyebrow--terracotta" style="margin: 0.6rem 0 0;">Air, light, shade — before the plan.</p>
            </div>
        </div>
    </div>
</section>

{# ── HOW WE WORK — three steps ──────────────────────────────────── #}
<section class="section section--lg" style="background: var(--coconut);">
    <div class="container">
        <p class="eyebrow">Section II.B <span class="square-mark"></span> How we work</p>
        <h2>Three steps.</h2>
        <p style="max-width: 56ch; color: var(--charcoal); margin-top: 0.4rem;">Every project moves through the same three steps, in this order, at the pace the site and the family need.</p>

        <div class="steps">
            <div class="step">
                <span class="step__num">01</span>
                <div class="step__icon" aria-hidden="true">
                    {# Compass icon #}
                    <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" stroke-width="2.5"/>
                        <circle cx="32" cy="32" r="18" fill="none" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M 32 8 L 36 32 L 56 32 L 36 32 L 32 56 L 28 32 L 8 32 L 28 32 Z" fill="#A8442B"/>
                        <circle cx="32" cy="32" r="3" fill="currentColor"/>
                    </svg>
                </div>
                <h3>Site.</h3>
                <p>We walk the site together. We sit in the morning sun and the afternoon shade. We note the wind, the neighbors' walls, the water table, the way you already use the lot. No drawings yet.</p>
            </div>

            <div class="step">
                <span class="step__num">02</span>
                <div class="step__icon" aria-hidden="true">
                    {# Plan scroll icon #}
                    <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                        <rect x="10" y="10" width="44" height="44" fill="none" stroke="currentColor" stroke-width="2.5"/>
                        <line x1="10" y1="22" x2="54" y2="22" stroke="currentColor" stroke-width="1.5"/>
                        <line x1="22" y1="10" x2="22" y2="54" stroke="currentColor" stroke-width="1.5"/>
                        <rect x="26" y="26" width="14" height="14" fill="#A8442B"/>
                        <line x1="38" y1="38" x2="50" y2="50" stroke="currentColor" stroke-width="1.5"/>
                        <line x1="36" y1="46" x2="44" y2="50" stroke="currentColor" stroke-width="1"/>
                    </svg>
                </div>
                <h3>Plan.</h3>
                <p>We draw — by hand at first, then in CAD. You review three rounds of plans, then we agree on materials, the structural system, and a build schedule the family can live with.</p>
            </div>

            <div class="step">
                <span class="step__num">03</span>
                <div class="step__icon" aria-hidden="true">
                    {# Key icon #}
                    <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="20" cy="32" r="11" fill="none" stroke="currentColor" stroke-width="2.5"/>
                        <circle cx="20" cy="32" r="4" fill="#A8442B"/>
                        <line x1="31" y1="32" x2="56" y2="32" stroke="currentColor" stroke-width="2.5"/>
                        <line x1="48" y1="32" x2="48" y2="42" stroke="currentColor" stroke-width="2.5"/>
                        <line x1="40" y1="32" x2="40" y2="40" stroke="currentColor" stroke-width="2.5"/>
                    </svg>
                </div>
                <h3>Build.</h3>
                <p>We are on site weekly through construction and on call for the contractor. We sign the building over on a single date with the family present, and we return for a one-year review after move-in.</p>
            </div>
        </div>
    </div>
</section>

{# ── INQUIRY STRIP ──────────────────────────────────────────────── #}
<div class="strip">
    <hr class="rule-4" style="position: absolute; top: 0; left: 0; right: 0;">
    <div class="strip__inner">
        <p class="strip__phrase">Begin a<br><em>project.</em></p>
        <div class="strip__cta">
            <p class="eyebrow eyebrow--charcoal" style="margin: 0 0 0.4rem;">Section V <span class="square-mark"></span> Inquiry</p>
            <p style="color: var(--ink); max-width: 32ch; margin: 0 0 1rem;">A short note about the site, the family, and the budget is enough to begin.</p>
            <p style="margin: 0;">
                <a class="btn" href="/inquiry">Make an inquiry</a>
            </p>
        </div>
    </div>
</div>

{% endblock %}
